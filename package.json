{
  "name": "tablevote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:lan": "concurrently -n web,api -c yellow,magenta \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/index.js --packages=external",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "test:browser": "playwright test --project=chromium && playwright test --project=firefox --grep-invert \"host removal and session ending\" && playwright test --project=firefox --grep \"host removal and session ending\" && playwright test --project=webkit",
    "generate:catalog": "node scripts/generate-demo-catalog.mjs",
    "check:catalog": "node scripts/generate-demo-catalog.mjs --check",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:repo": "node scripts/check-repository-files.mjs",
    "lint": "eslint .",
    "audit:prod": "node scripts/check-audit.mjs",
    "smoke:prod": "node server/smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "framer-motion": "^12.42.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.562.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "8.3.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "description": "Settle where to eat, fairly. Open-source group restaurant decision app.",
  "license": "MIT"
}
