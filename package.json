{
  "name": "tablevote",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:lan": "concurrently -n web,api -c yellow,magenta \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/index.js --packages=external",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:tooling": "node --test scripts/audit-report.test.mjs",
    "test:browser": "npm run build && npm run test:browser:built",
    "test:browser:built": "node scripts/run-browser-matrix.mjs",
    "generate:catalog": "node scripts/generate-demo-catalog.mjs",
    "check:catalog": "node scripts/generate-demo-catalog.mjs --check",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:repo": "node scripts/check-repository-files.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "node scripts/check-audit.mjs",
    "audit:all": "node scripts/check-audit.mjs --all",
    "smoke:prod": "npm run build && npm run smoke:prod:built",
    "smoke:prod:built": "node server/smoke.mjs",
    "verify": "npm run format:check && npm run lint && npm run check:docs && npm run check:repo && npm run check:catalog && npm run test:tooling && npm run test:coverage && npm run audit:prod && npm run audit:all && npm run build",
    "verify:full": "npm run verify && npm run test:browser:built && npm run smoke:prod:built",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "framer-motion": "^12.43.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "8.3.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "description": "Accountless group dining with private ballots and deterministic consensus ranking.",
  "license": "MIT",
  "author": "Haitham Al Maamari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaithamAlMaamari/tablevote.git"
  },
  "homepage": "https://github.com/HaithamAlMaamari/tablevote#readme",
  "bugs": {
    "url": "https://github.com/HaithamAlMaamari/tablevote/issues"
  },
  "packageManager": "npm@10.9.2"
}
