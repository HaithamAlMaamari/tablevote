# Vite loads VITE_* values from .env.local during development. The Node server
# does not load .env files; export server variables through the shell or process manager.

# Bind address and port for the API/socket server (production requires both explicitly).
# HOST=127.0.0.1
# PORT=3001
# Production startup requires exact HTTPS origins and a positive, verified proxy-hop count.
# NODE_ENV=production
# Number of trusted reverse-proxy hops in production (usually 1).
# TRUST_PROXY_HOPS=1
# Comma-separated exact browser origins allowed to use the app.
# ALLOWED_ORIGINS=https://tablevote.example

# The public prototype has no live provider integration or provider keys.
